# ---------------------------------------------------------------------------
# Private collection page
#
# VITE_PRIVATE_PATH   the unlisted URL. Nothing on the public site links to it
#                     and it is not in the sitemap, so it is only reachable by
#                     someone who has been given the address.
# VITE_PRIVATE_ASSET  basename of the sealed payload in public/.
#
# Changing either one means re-running: node tools/seal-collection.mjs
# and redeploying. Keep this file out of version control.
# ---------------------------------------------------------------------------
VITE_PRIVATE_PATH=change-me-to-a-random-string
VITE_PRIVATE_PATH_HASH=<run: node tools/private-path.mjs>
VITE_PRIVATE_ASSET=change-me-too
